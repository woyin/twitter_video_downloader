# 复制为 .env 后填入真实密钥;或在宿主机直接 export API_KEY=xxx
# 此密钥需与 iOS 快捷指令里填的 API Key 变量保持一致
# 必填:未设置时服务会拒绝所有 /extract 请求(fail-closed)
API_KEY=change-me-to-a-long-random-string

# 可选调优(默认值已适合单机小规模部署)
# CACHE_TTL_SECONDS=300          # 解析结果缓存秒数,0 关闭缓存
# CACHE_MAX_ENTRIES=256          # 缓存条目上限
# YTDLP_SOCKET_TIMEOUT=15        # yt-dlp 网络超时秒数
# MAX_CONCURRENT_EXTRACTIONS=8   # 同时进行的解析数上限
# EXTRACT_QUEUE_WAIT_SECONDS=20  # 排队等待超时,超时返回"服务繁忙"
# PORT=8000                      # 容器内监听端口
# WEB_CONCURRENCY=1              # uvicorn worker 进程数
